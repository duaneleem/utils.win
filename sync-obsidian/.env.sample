REM Copy this file to .env in this folder and set your values.
REM Lines must look like: KEY=value (no spaces around =). Lines starting with REM or # are ignored.

BASE_URL=http://192.168.50.218:13010
REM API_KEY: Settings -> Account -> API Keys (Generate). If that section is missing: Admin Panel ->
REM Settings -> General -> Authentication -> Enable API Keys (Save). Non-admins also need the
REM "API Keys" feature permission on their group (Admin Panel -> Users -> Groups).
API_KEY=replace-with-your-open-webui-api-key

REM Optional: HTTP client timeout in seconds for large PDF uploads (default 600)
REM HTTP_TIMEOUT_SECONDS=600

REM Optional: pause in milliseconds after each upload/attach attempt (default 0). Helps when the
REM server hits "Too many open files" (Errno 24) under rapid bulk uploads; pair with Docker ulimits.
REM UPLOAD_DELAY_MS=150

