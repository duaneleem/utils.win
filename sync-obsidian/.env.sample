REM Copy this file to .env in this folder and set your values.
REM Lines must look like: KEY=value (no spaces around =). Lines starting with REM or # are ignored.

BASE_URL=http://192.168.50.218:13010
REM API_KEY: Settings -> Account -> API Keys (Generate). If that section is missing: Admin Panel ->
REM Settings -> General -> Authentication -> Enable API Keys (Save). Non-admins also need the
REM "API Keys" feature permission on their group (Admin Panel -> Users -> Groups).
API_KEY=replace-with-your-open-webui-api-key

REM Optional: HTTP client timeout in seconds for large PDF uploads (default 600)
REM HTTP_TIMEOUT_SECONDS=600

REM Optional: pause in milliseconds after each upload/attach attempt (default 0). Helps when the
REM server hits "Too many open files" (Errno 24) under rapid bulk uploads; pair with Docker ulimits.
REM UPLOAD_DELAY_MS=150

REM Optional: comma-separated extensions including leading dot (default if unset: .md,.txt,.pdf,.html,.csv)
FILE_EXTENSIONS=.md,.txt,.pdf,.html,.csv

REM Optional: when removing a file from Knowledge after a local delete, pass delete_file=true (default)
REM to Open WebUI so the global file is deleted if you own it. Set false to only unlink from this Knowledge.
REM KNOWLEDGE_REMOVE_DELETE_FILE=true

REM Optional: emit a Write-Warning when upload or attach fails with empty content but the path is recorded
REM in the tracker (so later runs skip until the file changes). Default is off (no per-file warning).
REM WARN_EMPTY_CONTENT=true
REM Legacy alias (same effect if WARN_EMPTY_CONTENT is unset):
REM WARN_EMPTY_ATTACH=true

REM Optional: append all console host output (Write-Host, warnings, etc.) to this log file. Relative paths
REM are resolved from this folder (next to the script). Leave unset or empty to disable.
REM LOG_PATH=temp/output.log

REM Optional: before each run, trim that transcript log to the last N complete PowerShell transcript sessions
REM (default 3). Set to 0 to keep unlimited history (append only, no trim).
REM LOG_KEEP_RUNS=3

