# PDF to Text Converter - Environment Variables
# Copy this file to .env and update with your actual paths

# Tracker directory - where conversion history is stored
# Default: script's temp/ subdirectory
TRACKER_DIR="/path/to/sh-convert-pdf-to-text/temp"

# Default source directory (optional - script will prompt if not set)
# Example: /mnt/d/Documents/PDFs or /home/user/papers
# PDF_SOURCE_DIR="/path/to/your/pdf-files"

# Default target directory (optional - script will prompt if not set)
# Example: /mnt/d/Documents/TXT or /home/user/converted
# PDF_TARGET_DIR="/path/to/your/output-txt-files"

# OCR settings
OCR_MIN_WORDS=10  # Minimum words before triggering OCR fallback
OCR_DPI=300       # DPI for OCR image conversion (higher = better quality, slower)
OCR_LANG="eng"    # Tesseract language (eng, spa, fra, etc.)
